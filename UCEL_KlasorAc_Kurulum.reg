Windows Registry Editor Version 5.00

; ============================================================
; ÜÇEL Steel Construction — Ortak Klasör Tek Tık ile Açma (v2)
; ============================================================
; KULLANIM:
;   1) Bu dosyaya çift tıkla
;   2) Çıkan Windows uyarısında "Çalıştır" → "Evet" → "Tamam"
;   3) BİR KEZ kuruldu, hep çalışır.
;
; SONRA tarayıcıda ÜÇEL uygulaması Aç butonuna basınca
; çıkacak diyalogda "İzin ver" (Allow / Always open) seç.
; Bir defa kabul ettikten sonra her seferinde sessizce açılır.
;
; KALDIRMA: regedit aç → HKEY_CURRENT_USER\Software\Classes\ucelopen sil
; ============================================================

[HKEY_CURRENT_USER\Software\Classes\ucelopen]
@="URL:UCEL Open Folder"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\ucelopen\DefaultIcon]
@="explorer.exe,1"

[HKEY_CURRENT_USER\Software\Classes\ucelopen\shell]

[HKEY_CURRENT_USER\Software\Classes\ucelopen\shell\open]

[HKEY_CURRENT_USER\Software\Classes\ucelopen\shell\open\command]
@="powershell.exe -NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -Command \"$u=$args[0]; $u=$u -replace '^ucelopen:[/]{0,2}',''; $u=[System.Web.HttpUtility]::UrlDecode($u); $u=$u -replace '/','\\\\'; if($u -match '^[A-Z]:\\\\') {Start-Process explorer.exe -ArgumentList ('\"' + $u + '\"')} elseif($u -match '^\\\\\\\\') {Start-Process explorer.exe -ArgumentList ('\"' + $u + '\"')} else {Start-Process $u}\" \"%1\""
