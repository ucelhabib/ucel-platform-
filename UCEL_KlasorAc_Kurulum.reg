Windows Registry Editor Version 5.00

; ============================================================
; ÜÇEL Steel Construction — Ortak Klasör Tek Tık ile Açma (v3)
; ============================================================
; KURULUM:
;   1) Bu dosyaya çift tıkla → "Çalıştır" → "Evet" → "Tamam"
;   2) ÜÇEL'de "Aç" → ilk seferinde Chrome diyaloğunda
;      "İzin ver / Always open" seç
;
; NOT: Bu yöntem, projeler klasörünüzdeki UCEL_KlasorAc.ps1
;      script'ini çağırır. .ps1 dosyası aynı klasörde olmalı.
; ============================================================

[HKEY_CURRENT_USER\Software\Classes\ucelopen]
@="URL:UCEL Open Folder"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\ucelopen\DefaultIcon]
@="explorer.exe,1"

[HKEY_CURRENT_USER\Software\Classes\ucelopen\shell]

[HKEY_CURRENT_USER\Software\Classes\ucelopen\shell\open]

[HKEY_CURRENT_USER\Software\Classes\ucelopen\shell\open\command]
@="powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"C:\\Users\\ucelh\\OneDrive\\Masaüstü\\projeler\\UCEL_KlasorAc.ps1\" -Url \"%1\""
